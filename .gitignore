# State holds the database password IN CLEAR, plus every resource id.
# Pushing it to GitHub means publishing your secrets.
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup

# The Gemini API key. Never let this reach a Git repository.
.env
*.env

# Your own values: domain, email, company name, API key.
# terraform.tfvars.example stays versioned — it is the template to copy.
terraform.tfvars
*.auto.tfvars

# Terraform working files
.terraform/
.terraform.lock.hcl
crash.log
*.tfplan

# Misc
.DS_Store
__pycache__/
*.pyc
