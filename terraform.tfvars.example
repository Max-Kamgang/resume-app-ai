# ─────────────────────────────────────────────────────────────────────────────
#  CONFIGURATION
#
#      cp terraform.tfvars.example terraform.tfvars
#      # open terraform.tfvars and put YOUR values in
#      terraform init
#      terraform apply
#
#  If you skip this file, Terraform simply asks for the four values at launch.
#  That is a prompt, not an error.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ THE FOUR REQUIRED VALUES ════════════════════════════════════════════════

# 1. Your domain name.
#
#    BEFORE THE APPLY: a Route 53 hosted zone must already exist for this
#    domain in THIS AWS account, and your registrar must point at it.
#
#    Check (if nothing prints, create the zone first):
#      aws route53 list-hosted-zones-by-name --dns-name example.com
root_domain = "example.com"

# 2. Your real email address — an inbox you can OPEN.
#    AWS will send a verification link there: you must click it.
hr_email = "me@gmail.com"

# 3. Your company name.
#    Shown on the site; also composes the sender: "Utrains" -> "Utrains HR".
company_name = "Utrains"

# 4. Your Gemini API key — free at https://aistudio.google.com/apikey
#    This is what powers the CV screening.
#    Terraform writes it to /opt/rp-app/.env on the servers.
#    terraform.tfvars is excluded from Git: the key is in clear text here.
gemini_api_key = "PASTE-YOUR-GEMINI-KEY-HERE"


# ═══ EVERYTHING BELOW IS OPTIONAL ════════════════════════════════════════════
# These lines are commented out: the defaults work as-is.

# ═══ A SMALLER STACK ═════════════════════════════════════════════════════════
# Uncomment both lines to run the lighter variant.
#
# enable_nat_gateway = false
# instance_count     = 1
#
# enable_nat_gateway = false
#   Moves the servers out of the private subnets and into the public ones with
#   a public IP. They stay unreachable from the internet - the security group
#   only accepts port 80 from the load balancer and there is no SSH rule - but
#   you lose the private-subnet posture the project is partly built to show.
#
# instance_count = 1
#   Runs a single web server. The load balancer, the HTTPS termination and the
#   health checks all still work with one target behind them.

# ─── Email: Resend ───────────────────────────────────────────────────────────
# Without a key the stack sends through Amazon SES, which starts every new AWS
# account in a SANDBOX: you may only write to addresses verified one by one, so
# a demo with real candidates is impossible.
#
# With a key, Resend sends instead, to anyone, as soon as the domain is
# verified. SES stays configured as the fallback: if Resend refuses a message
# the email still goes out, and the failure is logged as an error.
#
# Setup takes about five minutes - see "Step 3" in the README:
#   1. Free account and API key at https://resend.com
#   2. Domains -> Add Domain, enter your root_domain
#   3. Copy the three records it prints into resend_dns_records below.
#      Do NOT paste them into the AWS console: Terraform owns the Route 53
#      zone and creates them for you.
#   4. terraform apply, then click Verify in the Resend dashboard
#
# resend_api_key = "re_xxxxxxxxxxxxxxxxxxxx"
#
# Names are RELATIVE to root_domain: write "send", not "send.example.com".
# The keys on the left are labels of your choosing.
#
# resend_dns_records = {
#   dkim = { name = "resend._domainkey", type = "TXT",   value = "p=MIGfMA0GCSq..." }
#   send = { name = "send",              type = "CNAME", value = "send.forge.rmta.net" }
#   mail = { name = "rsend",             type = "CNAME", value = "rsend.forge.rmta.net" }
# }

# AWS region. Screening runs on Gemini, so the region does not affect it.
# aws_region = "us-east-1"

# Score (0-100) at or above which the candidate is invited to interview.
# Inclusive: 80 accepts a score of 80 and rejects 79.
# match_threshold = 80

# HR portal logins for https://<app_subdomain>.<root_domain>/admin, where the
# match score and the AI review live. Left out, Terraform creates a single "hr"
# account; read its password with:
#   terraform output -raw hr_portal_password
# hr_portal_users = {
#   amina = "a-long-password-here"
#   serge = "another-long-password"
# }

# Portal subdomain. Site = <app_subdomain>.<root_domain>
# app_subdomain = "resume"

# Left part of the sender address. Final = <local>@<root_domain>
# sender_local_part = "no-reply"

# Sender name. Empty = "<company_name> HR".
# sender_display_name = "Utrains Recruiting"

# Gemini model used to score CVs.
# gemini_model = "gemini-3.8-flash"
